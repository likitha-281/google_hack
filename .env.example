# ==============================================================================
# VayuDrishti Climate Resilience Grid - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Orbital Satellite Ingestion (Mocked by default if empty)
SENTINEL_5P_CLIENT_ID=
SENTINEL_5P_CLIENT_SECRET=
ISRO_BHUVAN_AOD_TOKEN=

# Federated State SPCB Edge Endpoints (Mocked for local dev)
DPCC_EDGE_ENDPOINT=http://localhost:3001/fedlearn/v2
PPCB_EDGE_ENDPOINT=http://localhost:3002/fedlearn/v2
HSPCB_EDGE_ENDPOINT=http://localhost:3003/fedlearn/v2
UPPCB_EDGE_ENDPOINT=http://localhost:3004/fedlearn/v2
MPCB_EDGE_ENDPOINT=http://localhost:3005/fedlearn/v2

# Crowdsourced Citizen Evidence Limits
MAX_UPLOAD_SIZE_MB=10
ENABLE_LOCAL_VISION_ANALYZER=true
